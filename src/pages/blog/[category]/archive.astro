---
/**
 * /blog/<category>/archive — year index, scoped to a category.
 * Same shape as /blog/archive but only counts/years where this
 * category has posts.
 */
import AlmanacLayout from '@layouts/AlmanacLayout.astro';
import Header from '@components/almanac/Header.astro';
import Footer from '@components/almanac/Footer.astro';
import Closer from '@components/almanac/Closer.astro';
import Intro from '@components/almanac/blog/Intro.astro';
import FilterBar from '@components/almanac/blog/FilterBar.astro';
import YearIndex from '@components/almanac/blog/YearIndex.astro';
import EndMark from '@components/almanac/blog/EndMark.astro';
import { sortPosts, getSortedPosts, getCategoryChips } from '@utils/posts';
import { reverseSlug, slugify } from '@utils/slugs';
import { SITE } from '@config';
import { getCollection } from 'astro:content';

import '@styles/almanac/blog.css';

export const prerender = true;

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  const categories = Array.from(
    new Set(blogPosts.map((p) => p.data.category))
  );
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { categoryLabel: category },
  }));
}

interface Props {
  categoryLabel: string;
}
const { categoryLabel } = Astro.props;
const categorySlug = slugify(categoryLabel);
const displayCategory = reverseSlug(categorySlug);

const allInCategory = sortPosts(
  await getCollection('blog').then((all) =>
    all.filter((p) => p.data.category === categoryLabel)
  )
);
const allPosts = await getSortedPosts();
const totalInCategory = allInCategory.length;
const sinceYear = 2003;

const { chips: categoryChips } = await getCategoryChips({
  mustInclude: categoryLabel,
});

const groupedByYear = new Map<number, typeof allInCategory>();
allInCategory.forEach((p) => {
  const y = p.data.publishDate.getFullYear();
  if (!groupedByYear.has(y)) groupedByYear.set(y, []);
  groupedByYear.get(y)!.push(p);
});
const yearsDescending = Array.from(groupedByYear.keys()).sort((a, b) => b - a);

const firstInCategory = allInCategory[allInCategory.length - 1];
---

<AlmanacLayout
  title={`Archive · ${displayCategory} | Blog | ${SITE.title}`}
  description={`Year-by-year index of all ${totalInCategory} posts filed under ${displayCategory}.`}
  pageClass="blog blog-archive"
>
  <Header current="blog" />

  <main id="main">
    <Intro
      posts={allInCategory}
      sinceYear={sinceYear}
      currentCategory={displayCategory}
    />

    <FilterBar
      categories={categoryChips}
      totalCount={allPosts.length}
      active={categorySlug}
    />

    <div class="year-index" id="posts-list">
      {yearsDescending.map((year) => (
        <YearIndex
          year={year}
          posts={groupedByYear.get(year)!}
          href={`/blog/${categorySlug}/year/${year}`}
        />
      ))}
    </div>

    <EndMark
      showingCount={totalInCategory}
      totalCount={totalInCategory}
      firstPost={firstInCategory}
    />

    <Closer />
  </main>

  <Footer />
</AlmanacLayout>
