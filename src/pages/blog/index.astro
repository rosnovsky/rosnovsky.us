---
/**
 * /blog — the magazine front-of-book.
 *
 * Shows the N most-recent posts grouped by year, with a "Load older →"
 * link at the bottom that drills into /blog/archive (the full year
 * index). Designed to stay performant at thousands of posts: only the
 * recent slice renders here; deep history lives behind one click.
 */
import AlmanacLayout from '@layouts/AlmanacLayout.astro';
import Header from '@components/almanac/Header.astro';
import Footer from '@components/almanac/Footer.astro';
import Closer from '@components/almanac/Closer.astro';
import Intro from '@components/almanac/blog/Intro.astro';
import FilterBar from '@components/almanac/blog/FilterBar.astro';
import Featured from '@components/almanac/blog/Featured.astro';
import YearGroup from '@components/almanac/blog/YearGroup.astro';
import EndMark from '@components/almanac/blog/EndMark.astro';
import { getSortedPosts, getCategoryChips } from '@utils/posts';
import { SITE } from '@config';

import '@styles/almanac/blog.css';

export const prerender = true;

/** Posts to show on the landing page before "load older →" kicks in.
    Bump or lower as the archive grows. */
const RECENT_LIMIT = 50;

const allPosts = await getSortedPosts();
const totalPosts = allPosts.length;
const sinceYear = 2003;

const recentSlice = allPosts.slice(0, RECENT_LIMIT);
const [featured, ...recentRest] = recentSlice;

// Top-category chip counts come from the FULL archive so they don't
// shapeshift based on what's currently visible.
const { chips: categoryChips } = await getCategoryChips();

// Group the recent slice by year.
const groupedByYear = new Map<number, typeof recentRest>();
recentRest.forEach((p) => {
  const y = p.data.publishDate.getFullYear();
  if (!groupedByYear.has(y)) groupedByYear.set(y, []);
  groupedByYear.get(y)!.push(p);
});
const yearsDescending = Array.from(groupedByYear.keys()).sort((a, b) => b - a);

// PostRow numbering — descending across the whole archive
// (newest = totalPosts). Featured took the highest number.
const yearStartNums = new Map<number, number>();
let cursor = totalPosts - 1;
yearsDescending.forEach((y) => {
  yearStartNums.set(y, cursor);
  cursor -= groupedByYear.get(y)!.length;
});

const olderCount = Math.max(0, totalPosts - recentSlice.length);
---

<AlmanacLayout
  title={`Blog | ${SITE.title}`}
  description={`${totalPosts}-post archive — web development, hiking, music, books, and whatever rabbit hole I've fallen into. Writing since ${sinceYear}.`}
  pageClass="blog"
>
  <Header current="blog" />

  <main id="main">
    <Intro posts={allPosts} sinceYear={sinceYear} />

    <FilterBar
      categories={categoryChips}
      totalCount={totalPosts}
      active="all"
    />

    <div id="posts-list" aria-live="polite" aria-atomic="false">
      {featured && <Featured post={featured} />}

      {yearsDescending.map((year) => (
        <YearGroup
          year={year}
          posts={groupedByYear.get(year)!}
          startNum={yearStartNums.get(year)!}
        />
      ))}
    </div>

    {olderCount > 0 && (
      <div class="load-older">
        <a href="/blog/archive">
          Load {olderCount} older <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
    )}

    <EndMark showingCount={recentSlice.length} totalCount={totalPosts} />

    <Closer />
  </main>

  <Footer />
</AlmanacLayout>
