---
import AlmanacLayout from '@layouts/AlmanacLayout.astro';
import Header from '@components/almanac/Header.astro';
import Footer from '@components/almanac/Footer.astro';
import Closer from '@components/almanac/Closer.astro';
import Intro from '@components/almanac/blog/Intro.astro';
import FilterBar from '@components/almanac/blog/FilterBar.astro';
import Featured from '@components/almanac/blog/Featured.astro';
import YearGroup from '@components/almanac/blog/YearGroup.astro';
import EndMark from '@components/almanac/blog/EndMark.astro';
import { getSortedPosts, getTopCategories } from '@utils/posts';
import { slugify } from '@utils/slugs';
import { SITE } from '@config';

import '@styles/almanac/blog.css';

export const prerender = true;

// The Almanac redesign renders the entire archive on one page (no
// pagination); the [...page] catch-all stays as the route file so
// the existing /blog URL is generated. Old /blog/2..11 URLs are
// 301'd to /blog via public/_redirects.
export function getStaticPaths() {
  return [{ params: { page: undefined } }];
}

const allPosts = await getSortedPosts();
const totalPosts = allPosts.length;
// Source-of-truth copyright start (the blog content collection itself
// only goes back to 2013; earlier posts pre-date the current site).
const sinceYear = 2003;

// Featured = newest post; the rest of the list excludes it.
const [featured, ...rest] = allPosts;

// Top categories + counts for the filter chips.
const topCats = await getTopCategories();
const counts = new Map<string, number>();
allPosts.forEach((p) => {
  counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
});
const categoryChips = topCats.map((label) => ({
  label,
  slug: slugify(label),
  count: counts.get(label) ?? 0,
}));

// Group remaining posts by publish year for the magazine-TOC layout.
const groupedByYear = new Map<number, typeof rest>();
rest.forEach((p) => {
  const y = p.data.publishDate.getFullYear();
  if (!groupedByYear.has(y)) groupedByYear.set(y, []);
  groupedByYear.get(y)!.push(p);
});
const yearsDescending = Array.from(groupedByYear.keys()).sort((a, b) => b - a);

// Each year-group needs its highest post number so PostRow numbering
// stays descending across the whole archive (newest = totalPosts).
const yearStartNums = new Map<number, number>();
let cursor = totalPosts - 1; // featured took the highest number; -1
yearsDescending.forEach((y) => {
  yearStartNums.set(y, cursor);
  cursor -= groupedByYear.get(y)!.length;
});

const firstEver = allPosts[allPosts.length - 1];
---

<AlmanacLayout
  title={`Blog | ${SITE.title}`}
  description={`The full ${totalPosts}-post archive — web development, hiking, music, books, and whatever else. Writing since ${sinceYear}.`}
  pageClass="blog"
>
  <Header current="blog" />

  <main id="main">
    <Intro posts={allPosts} sinceYear={sinceYear} />

    <FilterBar
      categories={categoryChips}
      totalCount={totalPosts}
      active="all"
    />

    <div id="posts-list" aria-live="polite" aria-atomic="false">
      {featured && <Featured post={featured} />}

      {yearsDescending.map((year) => (
        <YearGroup
          year={year}
          posts={groupedByYear.get(year)!}
          startNum={yearStartNums.get(year)!}
        />
      ))}
    </div>

    <EndMark
      showingCount={totalPosts}
      totalCount={totalPosts}
      firstPost={firstEver}
    />

    <Closer />
  </main>

  <Footer />
</AlmanacLayout>
