---
import AlmanacLayout from '@layouts/AlmanacLayout.astro';
import Header from '@components/almanac/Header.astro';
import Footer from '@components/almanac/Footer.astro';
import Closer from '@components/almanac/Closer.astro';
import PostHead from '@components/almanac/post/PostHead.astro';
import PostTOC from '@components/almanac/post/PostTOC.astro';
import PostSidebar from '@components/almanac/post/PostSidebar.astro';
import PrevNext from '@components/almanac/post/PrevNext.astro';
import PostScripts from '@components/almanac/post/PostScripts.astro';
import { getSortedPosts } from '@utils/posts';
import type { Post } from '@types';

// Astro-Mastodon embed styles are still used by some MDX posts
import 'astro-mastodon/dist/output.css';

import '@styles/almanac/post.css';

export async function getStaticPaths() {
  const blogEntries = await getSortedPosts();
  return blogEntries.map((postEntry) => ({
    params: { slug: postEntry.slug.split('/').pop() },
    props: { postEntry },
  }));
}

interface Props {
  postEntry: Post;
}

export const prerender = true;

const { postEntry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await postEntry.render();

const minutesRead: string =
  remarkPluginFrontmatter?.minutesRead ?? '1 min read';

// Posts without h2 headings render no TOC, so the grid wrapper needs
// a modifier class to drop the left column — otherwise the article
// gets squeezed into the empty 220px TOC slot.
const hasToc = headings.some((h) => h.depth === 2);

// Determine prev/next + post number based on global sort order.
const allPosts = await getSortedPosts();
const totalPosts = allPosts.length;
const idx = allPosts.findIndex((p) => p.slug === postEntry.slug);
const postNum = totalPosts - idx; // newest = totalPosts, oldest = 1
const next = idx > 0 ? allPosts[idx - 1] : undefined; // newer in time
const prev = idx < allPosts.length - 1 ? allPosts[idx + 1] : undefined; // older
const nextNum = next ? postNum + 1 : undefined;
const prevNum = prev ? postNum - 1 : undefined;

// Nearby post for the sidebar — pick the closer of prev/next by date.
const nearby: Post | undefined = (() => {
  if (!prev && !next) return undefined;
  if (!prev) return next;
  if (!next) return prev;
  const thisTime = postEntry.data.publishDate.getTime();
  const prevDelta = Math.abs(thisTime - prev.data.publishDate.getTime());
  const nextDelta = Math.abs(thisTime - next.data.publishDate.getTime());
  return prevDelta <= nextDelta ? prev : next;
})();

const ogImage = postEntry.data.image.src;
const ogImageUrl = typeof ogImage === 'string' ? ogImage : ogImage?.src;
---

<AlmanacLayout
  title={postEntry.data.title}
  description={postEntry.data.description}
  ogImage={ogImageUrl}
  pageClass="post"
>
  <Header current="blog" />

  <main id="main">
    <article aria-labelledby="post-title" class={hasToc ? '' : 'no-toc'}>
      <PostHead post={postEntry} num={postNum} minutesRead={minutesRead} />

      {/* Hero image — full-bleed cover above the article body */}
      <figure class="hero-image">
        <img
          src={postEntry.data.image.src.src}
          width={postEntry.data.image.src.width}
          height={postEntry.data.image.src.height}
          alt={postEntry.data.image.alt}
          loading="eager"
          decoding="async"
        />
        <figcaption class="caption">
          <span class="credit">
            <span aria-hidden="true">↳</span> {postEntry.data.image.alt}
          </span>
          <span class="plate">PLATE 01 · COVER</span>
        </figcaption>
      </figure>

      <div class="article-wrap">
        <PostTOC headings={headings} />

        <div class="article">
          <Content />
        </div>

        <PostSidebar post={postEntry} minutesRead={minutesRead} nearby={nearby} />
      </div>
    </article>

    <PrevNext prev={prev} next={next} prevNum={prevNum} nextNum={nextNum} />

    <Closer />
  </main>

  <Footer />

  <PostScripts />
</AlmanacLayout>
