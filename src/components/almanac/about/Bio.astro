---
import heroPortrait from '@images/hero-portrait.jpg';

interface Props {
  /** Total post count for the meta card. Computed once at build time
      in about.astro from the blog collection. */
  totalPosts: number;
  /** Earliest publish year — drives the "Since 20XX" line. */
  sinceYear: number;
}

const { totalPosts, sinceYear } = Astro.props;
---

<section class="bio" aria-label="About Art">
  <div class="body">
    <figure class="portrait-inset" aria-hidden="true">
      <img
        src={heroPortrait.src}
        width={heroPortrait.width}
        height={heroPortrait.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span class="jade">·</span> Art Rosnovsky
        <span class="jade">·</span>
      </figcaption>
    </figure>

    <p>
      I'm a <strong>web developer</strong> based in Western Washington. I
      live about 50 miles north of Seattle in a small town called
      <em>Arlington</em>.
    </p>

    <blockquote>
      <p>
        For a while, I lived in London (not that one, but the one in
        Ontario, Canada) before moving to Vancouver (not that one, but the
        one in Washington; not that Washington, but Washington state). Now I
        live in Arlington (and not the one in Virginia, mind you!)
      </p>
    </blockquote>

    <p>
      After short gigs at Intel, AT&amp;T, and Microsoft, I ended up at
      <a href="https://auth0.com/">Auth0</a> (acquired by Okta in May 2021).
      I worked there in a couple of different roles, the latest one being
      Software Engineer. I've built Auth0's enterprise customer onboarding
      program, surrounding internal and external tooling, a bunch of
      high-profile customer facing features, and more. I was laid off in
      February 2024.
    </p>

    <p>
      Feel free to connect with me on
      <a href="https://lounge.town/@rosnovsky">Mastodon</a> or
      <a href="https://github.com/rosnovsky">Github</a>.
    </p>

    <blockquote>
      <p>
        For the longest time, I'd been a podcaster. In my previous life, I
        even was a minor radio celebrity, worked as a television producer
        and correspondent, and have done a bunch of front-line reporting
        from terrorist attacks, riots, and hostage situations. Yet here we
        are.
      </p>
    </blockquote>
  </div>

  <aside class="meta-card" aria-label="Profile">
    <div class="row">
      <div class="k">Name</div>
      <div class="v">Art Rosnovsky<small>he / him</small></div>
    </div>
    <div class="row">
      <div class="k">Role</div>
      <div class="v">
        Web<br />Developer<small>most recently: Auth0 / Okta</small>
      </div>
    </div>
    <div class="row">
      <div class="k">Lives in</div>
      <div class="v">
        Arlington<br />Washington<small
          ><span class="jade">~50 mi north of Seattle</span></small
        >
      </div>
    </div>
    <div class="row">
      <div class="k">Writing here</div>
      <div class="v">
        Since {sinceYear}<small>{totalPosts}+ posts</small>
      </div>
    </div>
    <div class="row">
      <div class="k">Pronouns</div>
      <div class="v">
        He / Him<small>🏳️‍⚧️ 🏳️‍🌈 ✊🏿 🇺🇦 🇵🇸</small>
      </div>
    </div>
  </aside>
</section>
