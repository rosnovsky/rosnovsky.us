---
/**
 * Career timeline — sourced from rosnovsky.us/about. Edit the events
 * array to add/remove entries. Exactly one entry marked `now: true`
 * gets the jade glow dot + "● now" label.
 *
 * The "now" entry's year auto-syncs to the current year so the page
 * never goes stale just because you forgot to bump a number.
 */
type Entry = {
  year: number;
  /** Mark exactly one entry as `now: true`. */
  now?: boolean;
  /** Prefix of the year to render in jade italic (e.g. "20" so 2026 = 20+26). */
  yearHi?: string;
  place: string;
  /** Inline HTML allowed for links / em accents. */
  what: string;
  desc?: string;
};

const currentYear = new Date().getFullYear();

const events: Entry[] = [
  {
    year: currentYear,
    now: true,
    yearHi: '20',
    place: 'Arlington, WA · between roles',
    what:
      'Currently exploring what comes next after BeyondID wrapped in January 2025.',
  },
  {
    year: 2024,
    yearHi: '20',
    place: 'BeyondID · Apr 2024 – Jan 2025',
    what:
      'Leading Auth0 implementations for Fortune 500 companies.',
  },
  {
    year: 2019,
    yearHi: '20',
    place: 'Auth0 · Dec 2019 – Apr 2024',
    what:
      'Software Engineer. Built internal/customer-facing tools and dashboard features. <em>Acquired by Okta in May 2021.</em> Laid off in February 2024.',
  },
  {
    year: 2019,
    yearHi: '20',
    place: 'Microsoft · Apr – Oct 2019',
    what: 'Built an internal search tool for the Customer Experience team.',
  },
  {
    year: 2018,
    yearHi: '20',
    place: 'Transmark Logistics · Dec 2018 – Apr 2019',
    what:
      'Built a new internal real-time shipment and resources tracking and processing system.',
  },
  {
    year: 2017,
    yearHi: '20',
    place: 'AT&T · Apr 2017 – Sep 2018',
    what: 'Worked on the MyServices team, addressing web and mobile app issues.',
  },
  {
    year: 2016,
    yearHi: '20',
    place: 'Intel · Dec 2016 – Apr 2017',
    what: "Implemented Intel's new Product Catalog.",
  },
  {
    year: 2003,
    yearHi: '20',
    place: 'A first post',
    what: 'Started a blog. Never stopped.',
    desc: "Twenty-plus years on, you're reading the latest iteration of it.",
  },
];

const yearTail = (y: number, hi: string | undefined) => {
  const s = String(y);
  if (!hi || !s.startsWith(hi)) return { hi: '', tail: s };
  return { hi, tail: s.slice(hi.length) };
};
---

<section class="timeline" aria-labelledby="tl-h">
  <div class="timeline-head">
    <h2 id="tl-h">A loose <em>timeline</em></h2>
    <div class="legend">
      partial · sourced from<br />
      <a href="/about">/about &amp; /blog →</a>
    </div>
  </div>

  <div class="tl-track">
    {events.map((e) => {
      const { hi, tail } = yearTail(e.year, e.yearHi);
      return (
        <div class={`tl-item${e.now ? ' now' : ''}`}>
          <div class="year">
            {hi && <em>{hi}</em>}
            {tail}
          </div>
          <div class="what">
            <span class="place">{e.place}</span>
            <Fragment set:html={e.what} />
            {e.desc && <p class="desc">{e.desc}</p>}
          </div>
        </div>
      );
    })}
  </div>
</section>
